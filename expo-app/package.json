{
  "name": "photobackup",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.5.2",
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/ui"
      ]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@photobackup/core": "workspace:*",
    "expo": "~57.0.11",
    "expo-background-task": "~57.0.14",
    "expo-battery": "^57.0.1",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.3",
    "expo-network": "^57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios --device",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    }
  },
  "private": true
}
