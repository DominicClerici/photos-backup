{
  "name": "photobackup",
  "version": "0.1.0",
  "main": "index.ts",
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "expo": "~57.0.11",
    "expo-battery": "^57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-media-library": "~57.0.3",
    "expo-network": "^57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    }
  },
  "private": true
}
