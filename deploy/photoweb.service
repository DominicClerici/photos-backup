# photoweb — the browser gallery, served to the house rather than to one machine.
#
# UNTESTED, like photod.service: written alongside the browser gate. See
# deploy/README.md.
#
#   sudo cp deploy/photoweb.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now photoweb
#
# This unit runs Next. It does not run the gate: photod does, in front of this,
# and this process is not reachable from the network at all.
#
#   laptop --https--> photod :8787 --+--> /v1/*  the archive, behind the cookie
#                                    +--> /*     this unit, over loopback
#
# ## The one thing that must not be got wrong
#
# -H 127.0.0.1. This server proxies /api/* straight to photod's *plaintext*
# listener, which has no authentication and serves the whole archive — that is
# what it is for, and why it is bound to loopback. Binding this to 0.0.0.0 puts
# an unauthenticated door beside the locked one, and nothing would fail loudly:
# the gallery would simply work, for anyone on the Wi-Fi.
#
# The gate is in photod because photod is what the network can reach.
#
# ## Building it
#
# PHOTOD_URL and NEXT_PUBLIC_MEDIA_BASE are read by `next build`, not by
# `next start` — they are frozen into the route manifest. Build with neither set
# and the defaults are right: /api goes to photod's loopback listener, and media
# goes through /api too, which under photod is the same origin the cookie is on.
#
#   cd web && pnpm install --prod=false && pnpm build
#   sudo rsync -a --delete web/ /opt/photobackup/web/
#
# Setting NEXT_PUBLIC_MEDIA_BASE to photod's LAN address would point every
# thumbnail at a URL the browser has no cookie for. They would all 401.

[Unit]
Description=photobackup gallery (Next.js)
Documentation=https://github.com/dominicclerici/photos-backup
After=network-online.target photod.service
Wants=network-online.target
# Not Requires: the gallery starting before photod is a page that says the
# archive is unreachable, which is better than a unit that refuses to start.

[Service]
Type=simple
User=photoweb
Group=photoweb
WorkingDirectory=/opt/photobackup/web
Environment=NODE_ENV=production
# Loopback. Read the note above before changing this.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5s

# It serves a compiled bundle and proxies JSON. It has no business anywhere else
# on the disk, and in particular none at all on the archive drive: every
# photograph it shows comes from photod over a socket.
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/photobackup/web
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
