# Copy to /etc/photod/photod.env, owned by root, mode 0640, group photod —
# it holds the database password.
#
#   sudo install -d -m 0755 /etc/photod
#   sudo install -m 0640 -g photod deploy/photod.env.example /etc/photod/photod.env

# The archive. Holds blobs/, manifest.jsonl and incoming/. The external drive.
PHOTOS_ROOT=/mnt/photos

# Thumbnails and playback renditions. The SSD: the gallery is served from here,
# and every file under it can be rebuilt from the blobs if the disk is lost.
DERIVATIVES_ROOT=/var/lib/photod/derivatives

DATABASE_URL=postgres://photobackup:CHANGE_ME@localhost:5432/photobackup?sslmode=disable

# The offline geocoder's reference tables: cities500, the admin1 codes and the
# country names, exactly as downloaded from geonames.org. On the SSD, not the
# archive drive — this is a reference table that can be re-downloaded rather than
# part of the library.
#
# Optional. Without it photographs keep their coordinates and have no place
# name, and photod says so once at startup. deploy/README.md has the three
# curls; `photobackup-admin geocode` names the places for what is already here.
GEONAMES_DIR=/var/lib/photod/geonames

# The HTTPS listener. This is what the phone talks to and what mDNS advertises.
LISTEN_ADDR=:8787

# The CA and server certificate photod issues for itself. On the SSD, not the
# archive drive: ca.key is machine identity rather than part of the library, and
# it is the one file here whose loss means re-pairing every device.
TLS_DIR=/var/lib/photod/tls

# A second listener, in the clear, serving the gallery's own endpoints and
# /health. No pairing, and not the phone's upload path, so a device token cannot
# cross it. The Next app and the photobackup CLI use it so they need not trust a
# private CA to read a thumbnail.
#
# Loopback on purpose. Widening this to the LAN puts the entire archive within
# reach of anyone on the network, because none of what it serves is
# authenticated: not the reads, not the trash, and not the browser upload page,
# which can put a new photograph into the archive. Deliberate, documented, and
# still a decision worth making on purpose.
PLAINTEXT_ADDR=127.0.0.1:8788

# Extra names or addresses to certify, beyond the ones photod can see from the
# inside. Usually unnecessary: it already certifies every address on every
# interface that is up, the hostname, <hostname>.local, and the loopbacks, and it
# reissues the certificate within five minutes of any of them changing.
#
# A phone dialling something not in the certificate refuses the connection.
# `photobackup ca` prints the current list.
# TLS_EXTRA_SANS=photos.example.com,203.0.113.10

# Fedora already runs Avahi, which owns port 5353. The built-in responder will
# not be able to bind alongside it, so publish the service through Avahi
# instead and turn this one off:
#
#   /etc/avahi/services/photobackup.service
MDNS_DISABLED=1

# exiftool and the 256px thumbnails. The gallery is blocked on this work.
WORKER_CONCURRENCY=4

# Video transcodes. Four, measured rather than guessed: on this machine's queue
# it is worth 1.9x over one worker on the three-second Live Photo sidecars that
# dominate the queue by count, and nothing at all beyond four. On the long
# clips it is worth almost nothing either way — one 1080p clip already spends
# 90s of CPU for 4s of wall, so the cores are gone before a second worker
# starts. Concurrency is the small lever here; VIDEO_ENCODER below is the big
# one.
TRANSCODE_CONCURRENCY=4

# The duplicate scan's own decoder pool: one full decode of every original in
# the archive, plus twenty sampled frames out of every video. One by default and
# deliberately the smallest of the three — nothing is waiting for the answer, and
# a backfill should be something the machine does in the background over an hour
# rather than instead of serving the gallery.
#
# Raise it to finish a first pass sooner; the gallery's thumbnails and the
# viewer's playback renditions are what it competes with.
SIGNATURE_CONCURRENCY=1

# The renditions a vision model reads: one uncropped 512px WebP per photograph,
# six frames per video. Another full decode of every visible original, and the
# thing waiting for the output is a search feature that does not exist yet — so
# like the signature pass it is sized to run in the background rather than
# instead of the gallery. Two rather than one because each item here is a single
# ImageMagick, not twenty sampled frames.
PREP_CONCURRENCY=2

PREVIEW_CONCURRENCY=4

# Where photo-ml is listening. Empty — or absent — means there is none, and that
# is a supported way to run this archive forever: PROJECT.md §4's hard rule is
# that photo-ml is optional, so the default is off and turning it on is this
# line.
#
# Without it the vision pool is not started and no vision work is queued. Not
# "queued and never drained" — a machine with no GPU service would otherwise
# report a permanent 17,788-item backlog for a feature it does not have.
# Setting this and restarting photod is what turns the whole library into queued
# work, through jobs.ReconcileVision, and a first backfill is about fifteen
# minutes on the card once the renditions exist.
#
# That covers the embeddings only. The captioner and the text recogniser are
# started by hand — `photobackup ml backfill` — because hours of GPU work begun
# by a service restart is a restart with a surprise in it. See
# server/README.md § Searching.
#
# photod does not need photo-ml to be up when it starts, or ever. See
# deploy/photo-ml.service and photo-ml/README.md.
ML_URL=http://127.0.0.1:8789

# The pool that hands the renditions to photo-ml: embeddings, then recognised
# text, then captions, drained in that order of priority rather than FIFO.
#
# Four, and it used to be one. The old reasoning was sound and is now obsolete —
# a queue in front of one GPU gains nothing from a second worker. What changed
# is that photo-ml learned to batch: the captioner reads 8.8GB of weights per
# generated token whether that token is for one image or twelve, so a batch of
# four costs barely more than one. The batch can only form if several requests
# are in flight, and this is what puts them there.
#
# 4 is also exactly one describe batch, so raising this no longer speeds the
# captioning pass up: PHOTO_ML_DESCRIBE_BATCH is 4 and the card is the limit.
VISION_CONCURRENCY=4

# How long the embedding and text-recognition queues must have been quiet — both
# empty and nothing finished — before the captioner is allowed onto the card.
#
# Empty is not the question, and that is the whole reason this exists. A phone
# uploading a photograph every two seconds keeps the recogniser loaded, and the
# GPU is fast enough that the ocr queue is empty almost all of the time in
# between — so a describe job is claimable in the gap, the captioner loads, and
# a describe job every two seconds means its idle timer never runs out. The next
# ocr request loads the recogniser beside ten gigabytes of captioner, and the
# card holds both until something fails to allocate.
#
# jobs.ClaimInOrder and photo-ml's one-directional eviction are both correct
# about a queue that is not being refilled. This is what makes that true while a
# phone is uploading.
#
# Nothing else waits on it: a new photograph is embedded and read within seconds
# of arriving, and is searchable by its text and by what it looks like the whole
# time it is waiting for a caption. Two minutes is comfortably longer than a
# burst of uploads is spaced and comfortably shorter than anybody's patience.
DESCRIBE_QUIET_SECONDS=120

# Which text recogniser wrote a row, and photod's half of photo-ml's
# PHOTO_ML_OCR_MODEL_TYPE. The two have to say the same thing: photod stores this
# on every row it writes and reads text back by it, and worker.checkModel says so
# once when they disagree.
#
# Changing it is a data operation rather than a migration — the rows under the
# old name stay where they are, and `photobackup ml backfill --kind ocr` finds
# every asset the new name has said nothing about. That is what made the move off
# the old "rapidocr" a backfill somebody could stop halfway.
#PHOTOD_OCR_MODEL=rapidocr-v6-medium

# h264_nvenc, and it has now been verified rather than assumed: it encodes, it
# is roughly 2.5x faster end to end, and on the 1080p iPhone footage that is
# essentially all of this library it landed within a VMAF point of libx264
# -crf 22 at comparable size. The one case where it gives ground is heavy
# detail downscaled from 4K — a dashcam clip needed roughly -cq 20 to keep up,
# where the iPhone clips are happy at 28. What it really buys is
# CPU. libx264 draining the queue slows the thumbnail pool the gallery is
# blocked on by 3.6x; NVENC slows it by 1.3x.
#
# The quality target is NOT interchangeable between the two, which is why the
# server translates it (video.videoArgs) instead of passing -crf to both.
# NVENC ignores -crf silently: wiring it up naively gets you NVENC's stock
# 2Mbps VBR and a measured VMAF of 76 where libx264 scored 91.6. Nothing errors
# out; the archive just quietly fills with worse video.
#
# The smallest renditions are encoded in software regardless of what is set
# here: NVENC refuses any frame under 145px, and the 96px Live Photo motion
# thumbnail is one. The server picks per output (video.encoderFor) — an archive
# whose Live Photos are all marked failed is what this looked like before it
# did.
#
# Set libx264 to move this config to a machine without the card.
VIDEO_ENCODER=h264_nvenc

# How long an abandoned partial upload is kept before being swept. Long enough
# to outlast a phone that lost Wi-Fi overnight.
UPLOAD_SESSION_TTL=24h

# How often photod looks for items whose 365 days in Recently Deleted have run
# out. The question is one index probe and the answer is nearly always "nothing",
# so the interval buys resolution that a year-long window does not need much of.
#
# PURGE_DISABLED=1 stops the sweep entirely: deleted items then wait
# indefinitely and nothing removes an original unless somebody asks for it by
# hand from the gallery. A coherent thing to want, and the reason it is a flag.
PURGE_INTERVAL=1h

# How long the Archive and Hidden buckets stay unlocked without being used.
#
# Idle time rather than a fixed session: a vault being read is a vault somebody
# is sitting in front of. Fifteen minutes is the compromise between the two ways
# of getting this wrong — shorter, and browsing your own archive means typing a
# password every few minutes, which is how people end up choosing a password
# they can type quickly; longer, and a machine walked away from is an open
# vault.
#
# The encrypted trees themselves are not configurable. They are `vault/` under
# PHOTOS_ROOT and under DERIVATIVES_ROOT, so the same "originals on the slow
# disk, renditions on the SSD" split holds on both sides of the lock.
#
# There is no setting here for the password, and there will not be one. It is
# never on disk in any form a machine can use: the private key it protects is
# sealed under Argon2id in Postgres, and a copy of the password in an env file
# would make the whole thing a lock with the key taped to it.
VAULT_IDLE=15m
