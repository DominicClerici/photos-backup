# Copy to /etc/photod/photod.env, owned by root, mode 0640, group photod —
# it holds the database password.
#
#   sudo install -d -m 0755 /etc/photod
#   sudo install -m 0640 -g photod deploy/photod.env.example /etc/photod/photod.env

# The archive. Holds blobs/, manifest.jsonl and incoming/. The external drive.
PHOTOS_ROOT=/mnt/photos

# Thumbnails and playback renditions. The SSD: the gallery is served from here,
# and every file under it can be rebuilt from the blobs if the disk is lost.
DERIVATIVES_ROOT=/var/lib/photod/derivatives

DATABASE_URL=postgres://photobackup:CHANGE_ME@localhost:5432/photobackup?sslmode=disable

# The HTTPS listener. This is what the phone talks to and what mDNS advertises.
LISTEN_ADDR=:8787

# The CA and server certificate photod issues for itself. On the SSD, not the
# archive drive: ca.key is machine identity rather than part of the library, and
# it is the one file here whose loss means re-pairing every device.
TLS_DIR=/var/lib/photod/tls

# A second listener, in the clear, serving only the gallery's read endpoints and
# /health — no pairing and no upload path, so a device token cannot cross it.
# The Next app and the photobackup CLI use it so they need not trust a private
# CA to read a thumbnail.
#
# Loopback on purpose. Widening this to the LAN puts the entire archive within
# reach of anyone on the network, because the read path has no authentication
# yet. Deliberate, documented, and still a decision worth making on purpose.
PLAINTEXT_ADDR=127.0.0.1:8788

# Extra names or addresses to certify, beyond the ones photod can see from the
# inside. Usually unnecessary: it already certifies every address on every
# interface that is up, the hostname, <hostname>.local, and the loopbacks, and it
# reissues the certificate within five minutes of any of them changing.
#
# A phone dialling something not in the certificate refuses the connection.
# `photobackup ca` prints the current list.
# TLS_EXTRA_SANS=photos.example.com,203.0.113.10

# Fedora already runs Avahi, which owns port 5353. The built-in responder will
# not be able to bind alongside it, so publish the service through Avahi
# instead and turn this one off:
#
#   /etc/avahi/services/photobackup.service
MDNS_DISABLED=1

# exiftool and the 256px thumbnails. The gallery is blocked on this work.
WORKER_CONCURRENCY=4

# Video transcodes. One by default because ffmpeg already spreads a single clip
# across cores — but a backfill of several hundred videos is serialized behind
# this number, so raise it if the queue is the bottleneck and the machine is
# otherwise idle.
TRANSCODE_CONCURRENCY=1

PREVIEW_CONCURRENCY=4

# libx264 works everywhere. The NVIDIA card can try h264_nvenc, which is far
# faster and slightly larger for the same quality — verify it actually encodes
# before trusting a backfill to it.
VIDEO_ENCODER=libx264

# How long an abandoned partial upload is kept before being swept. Long enough
# to outlast a phone that lost Wi-Fi overnight.
UPLOAD_SESSION_TTL=24h
