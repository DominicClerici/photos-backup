#!/bin/sh
# photobackup, run as the photod user with the daemon's own environment.
#
# The CLI reads its configuration from the environment exactly as photod does,
# and EnvironmentFile= in the unit is the only thing that loads photod.env. A
# bare `sudo -u photod photobackup ...` therefore gets config.FromEnv's
# fallbacks: ./data/photos relative to the current directory, and the
# development database URL. Two of those fail without looking like failure —
# `ca` mints a second, unrelated CA, and `verify` gives an all-clear from an
# empty archive.
#
# systemd-run reads the env file as root before dropping to photod, so the
# database password never reaches a command line or `ps`.
#
#   sudo install -m 0755 deploy/photobackup-admin /usr/local/bin/
#
# Usage: photobackup-admin <pair|devices|ca|passkey|recovery|web|verify|export|
#                          reindex|geocode|import|reset|migrate> [args...]
#        photobackup-admin redeploy [--src DIR] [--no-db] [--dry-run]
#
# `redeploy` is the one subcommand that is not a photobackup subcommand. It
# rebuilds photod and photobackup from a source tree and swaps them in, so it
# runs as the invoking user — the Go build cache belongs to that user, and
# photod has no shell, no toolchain and no read access to the repository.

set -eu

ENV_FILE=${PHOTOD_ENV:-/etc/photod/photod.env}
BIN_DIR=/usr/local/bin
UNIT_DIR=/etc/systemd/system
AVAHI_SERVICE=/etc/avahi/services/photobackup.service

die() {
	echo "photobackup-admin: $*" >&2
	exit 1
}

# Every photobackup invocation goes through here: systemd-run reads the env
# file as root before dropping to photod, so the database password never
# reaches a command line or `ps`.
as_photod() {
	sudo systemd-run --pty --quiet --collect \
		--uid=photod --gid=photod \
		--property="EnvironmentFile=$ENV_FILE" \
		--property=WorkingDirectory=/ \
		"$BIN_DIR/photobackup" "$@"
}

# ---------------------------------------------------------------- redeploy ---

DRY=
UNITS_CHANGED=

redeploy_usage() {
	cat >&2 <<'EOF'
usage: photobackup-admin redeploy [--src DIR] [--no-db] [--no-web] [--dry-run]

Rebuild photod, photobackup and the gallery from the source tree, sync the
systemd units, cycle the Postgres container, apply any pending database
migrations, and restart photod and photoweb. Everything is built before
anything is stopped, so a tree that does not compile leaves the running
services exactly where they were.

  --src DIR   repository to build from. Defaults to $PHOTOBACKUP_SRC, then to
              the repository containing the current directory.
  --no-db     leave the database alone. For a Postgres that this compose file
              does not own, or a deploy that must not interrupt it.
  --no-web    leave the gallery alone. Skipped automatically on a machine that
              has not deployed it, so this is for skipping a slow npm build on
              one that has.
  --dry-run   print what would happen and change nothing.
EOF
}

run() {
	if [ -n "$DRY" ]; then
		printf '  would: %s\n' "$*"
	else
		"$@"
	fi
}

step() {
	printf '==> %s\n' "$*"
}

# repo_root walks up from a directory looking for the module root and the
# deploy tree together, so a stray go.mod elsewhere cannot be mistaken for it.
repo_root() {
	dir=$(cd "$1" 2>/dev/null && pwd) || return 1
	while :; do
		if [ -f "$dir/server/go.mod" ] && [ -d "$dir/deploy" ]; then
			printf '%s\n' "$dir"
			return 0
		fi
		if [ "$dir" = "/" ]; then
			return 1
		fi
		dir=$(dirname "$dir")
	done
}

# An installed unit that has drifted from the repository is the common case
# here: the file under /etc is a copy, and nothing else updates it. Files that
# were never installed are reported rather than created — redeploy replaces a
# deployment, it does not perform the first one.
sync_unit() {
	# Prefixed because sh has no locals and redeploy holds a $src of its own.
	_src=$1
	_dest=$2
	if [ ! -e "$_dest" ]; then
		echo "  skip    $_dest (never installed)"
		return 0
	fi
	if cmp -s "$_src" "$_dest"; then
		return 0
	fi
	echo "  update  $_dest"
	run sudo install -m 0644 "$_src" "$_dest"
	UNITS_CHANGED=yes
}

# Replacing a file in place truncates the inode that a running process — or
# this very script — is still reading from. Write beside it and rename, which
# is atomic and leaves anything holding the old file holding a whole one.
install_atomic() {
	_src=$1
	_dest=$2
	_mode=$3
	run sudo install -m "$_mode" "$_src" "$_dest.new"
	run sudo mv -f "$_dest.new" "$_dest"
}

# /health is unauthenticated — the phone pings a remembered address to see
# whether it still answers, which it must be able to do before it has a token
# and after one has been revoked. That makes it the one check proving photod
# came back up rather than merely started.
#
# It used to read PLAINTEXT_ADDR and default to 127.0.0.1:8788. Both were gone:
# Phase 17 removed the plaintext listener along with the shared gallery
# password, and the setting with it. Nothing has listened on 8788 since, so this
# spent fifteen seconds polling a closed port and then failed every successful
# deploy. It is one origin now, the same one everything else uses.
health_addr() {
	addr=$(sudo awk -F= '/^[[:space:]]*LISTEN_ADDR[[:space:]]*=/ {
		gsub(/[[:space:]]/, "", $2); print $2; exit }' "$ENV_FILE" 2>/dev/null || true)
	[ -n "$addr" ] || addr=127.0.0.1:8787
	case $addr in
	:*) addr=127.0.0.1$addr ;;
	# 0.0.0.0 and [::] are bind addresses, not places to dial.
	0.0.0.0:*) addr=127.0.0.1:${addr#*:} ;;
	\[::\]:*) addr=127.0.0.1:${addr##*:} ;;
	esac
	printf '%s\n' "$addr"
}

# https now, and verified rather than skipped: photod's certificate is issued by
# its own CA, which is exactly the CA sitting in TLS_DIR. Reading it needs root
# because that directory is 0700 photod, and sudo is already cached by here.
tls_dir() {
	dir=$(sudo awk -F= '/^[[:space:]]*TLS_DIR[[:space:]]*=/ {
		gsub(/[[:space:]]/, "", $2); print $2; exit }' "$ENV_FILE" 2>/dev/null || true)
	[ -n "$dir" ] || dir=/var/lib/photod/tls
	printf '%s\n' "$dir"
}

wait_healthy() {
	_ca=$(tls_dir)/ca.crt
	i=0
	while [ "$i" -lt 30 ]; do
		if sudo curl -sf --max-time 2 --cacert "$_ca" \
			"https://$1/health" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	return 1
}

# ---------------------------------------------------------------- database ---

# Postgres runs from the repository's docker-compose.yml, not from a system
# unit (deploy/README.md § The database), and the compose file sets no restart
# policy — so a machine that has rebooted since the last deploy comes back with
# photod running and the container exited. Cycling it here is what makes
# `redeploy` a deploy of the stack rather than of the binaries alone: migrations
# used to be the first thing to notice the database was gone, by which point
# photod was already stopped.
DB_SERVICE=postgres
NO_DB=
COMPOSE=
COMPOSE_FILE=
DB_WAIT=

# Resolved before anything is stopped, for the same reason the build is: an
# unusable docker should cost nothing but the time it took to find out.
db_detect() {
	if [ -n "$NO_DB" ]; then
		return 0
	fi
	COMPOSE_FILE=$1/docker-compose.yml
	if [ ! -f "$COMPOSE_FILE" ]; then
		echo "  note: no $COMPOSE_FILE — leaving the database alone" >&2
		return 0
	fi
	if ! command -v docker >/dev/null 2>&1; then
		echo "  note: docker is not on PATH — leaving the database alone" >&2
		return 0
	fi
	# Membership in the docker group is the normal case; sudo is the fallback
	# for a machine whose socket is root-only. -n rather than a prompt because
	# redeploy has already cached the credentials by the time this runs, and a
	# --dry-run must not start asking for passwords.
	if docker info >/dev/null 2>&1; then
		COMPOSE="docker compose"
	elif sudo -n docker info >/dev/null 2>&1; then
		COMPOSE="sudo docker compose"
	else
		die "redeploy: docker is installed but not usable by $(id -un) — add yourself to the docker group, or pass --no-db and manage postgres yourself"
	fi
	if ! $COMPOSE version >/dev/null 2>&1; then
		command -v docker-compose >/dev/null 2>&1 ||
			die "redeploy: neither 'docker compose' nor 'docker-compose' works here — pass --no-db to skip the database"
		COMPOSE=${COMPOSE%docker compose}docker-compose
	fi
	# `up --wait` blocks on the healthcheck the compose file already defines,
	# which is a better readiness signal than anything reconstructed out here.
	# Older compose does not have it; db_wait_ready covers those.
	if $COMPOSE up --help 2>/dev/null | grep -q -- '--wait'; then
		DB_WAIT=--wait
	fi
}

compose() {
	# Unquoted on purpose: $COMPOSE is a command with its subcommand attached.
	run $COMPOSE -f "$COMPOSE_FILE" "$@"
}

db_wait_ready() {
	i=0
	while [ "$i" -lt 60 ]; do
		if $COMPOSE -f "$COMPOSE_FILE" exec -T "$DB_SERVICE" \
			pg_isready -q >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	return 1
}

# Stop and start rather than `restart`, so a compose file that has itself
# changed — a new image tag, a new volume — is actually applied. The data lives
# in the pgdata volume, which neither one touches.
db_cycle() {
	if [ -z "$COMPOSE" ]; then
		return 0
	fi
	step "cycling postgres"
	# Every status checked by hand: db_cycle is called from a || list, which
	# turns set -e off for everything it runs.
	if ! compose stop "$DB_SERVICE"; then
		db_failed "could not stop $DB_SERVICE"
		return 1
	fi
	if ! compose up -d $DB_WAIT "$DB_SERVICE"; then
		db_failed "$DB_SERVICE did not come up"
		return 1
	fi
	if [ -n "$DRY" ]; then
		return 0
	fi
	if [ -z "$DB_WAIT" ] && ! db_wait_ready; then
		db_failed "$DB_SERVICE is up but not accepting connections"
		return 1
	fi
}

db_failed() {
	echo >&2
	echo "photobackup-admin: $* — photod left stopped" >&2
	echo "  the new binaries are installed; once the database is back:" >&2
	echo "    $COMPOSE -f $COMPOSE_FILE logs --tail=30 $DB_SERVICE" >&2
	echo "    photobackup-admin migrate && sudo systemctl start photod" >&2
}

# --------------------------------------------------------------- the gallery ---

# The Next bundle, which is deployed the way photo-ml's venv is not: it is small,
# it is built from this same tree, and it goes stale in lockstep with the API it
# calls. So unlike the 4GB venv, rebuilding it on every redeploy is cheap enough
# to be the default.
#
# It builds as the invoking user for the reason the Go binaries do — the npm
# cache belongs to that user, and photoweb has no shell, no toolchain and no
# read access to the repository.
WEB_DEST=/opt/photoweb
NO_WEB=
WEB_STAGE=

# Resolved before anything is stopped, like db_detect and for the same reason: a
# missing toolchain should cost nothing but the time it took to find out.
#
# Every path out of here is a skip rather than a failure. A machine that never
# installed the gallery is the normal case — photod serves the API alone
# perfectly well, and frontdoor.go degrades to exactly that — so redeploy
# replaces a deployment here too, it does not perform the first one.
web_detect() {
	if [ -n "$NO_WEB" ]; then
		return 0
	fi
	if [ ! -d "$1/web" ]; then
		echo "  note: no $1/web — leaving the gallery alone" >&2
		return 0
	fi
	if [ ! -d "$WEB_DEST" ]; then
		echo "  note: $WEB_DEST does not exist — the gallery has not been deployed here" >&2
		echo "        run deploy/photoweb-deploy once to create it, then redeploy" >&2
		NO_WEB=yes
		return 0
	fi
	if ! command -v npm >/dev/null 2>&1; then
		echo "  note: npm is not on PATH — leaving the gallery alone" >&2
		NO_WEB=yes
		return 0
	fi
	if ! command -v rsync >/dev/null 2>&1; then
		echo "  note: rsync is not on PATH — leaving the gallery alone" >&2
		NO_WEB=yes
		return 0
	fi

}

# photod finds the gallery through WEB_APP_URL and the gallery binds PORT, and
# nothing else makes the two agree. When they disagree photod does not error —
# it either reverse-proxies whatever else happens to be on that port, from the
# archive's own origin behind the archive's own session, or it answers 502 for
# a gallery that was never there. An unrelated dev server on 3000 is the first;
# a WEB_APP_URL pointed at a port nothing listens on is the second.
#
# Deliberately not part of web_detect's skip chain. It was, and that was
# backwards: the check got suppressed precisely when the gallery was not
# deployed, which is exactly the case where WEB_APP_URL is most likely to be
# pointing at nothing. A misconfigured URL is worth reporting whether or not
# there is a gallery to go with it.
web_check_url() {
	# -n rather than a prompt, for the reason db_detect gives: this runs before
	# sudo -v on a --dry-run, and a dry run must not start asking for passwords.
	if ! sudo -n test -r "$ENV_FILE" 2>/dev/null; then
		# Say nothing rather than something wrong. Reporting "WEB_APP_URL is
		# unset" when the file simply could not be opened is the more expensive
		# mistake — it is the one setting that silently points photod at
		# another process entirely.
		return 0
	fi
	_want=$(web_port "$1")
	_have=$(sudo -n awk -F= '/^[[:space:]]*WEB_APP_URL[[:space:]]*=/ {
		gsub(/[[:space:]]/, "", $2); print $2; exit }' "$ENV_FILE" 2>/dev/null || true)
	case $_have in
	*:"$_want")
		# Agreed on the port. Whether anything is actually listening there is
		# web_healthy's question, after the restart.
		;;
	"")
		# Not "no gallery". config.FromEnv falls back to
		# http://127.0.0.1:3000 when this is unset or empty, so an
		# unconfigured photod proxies whatever is on 3000 — which on a machine
		# somebody writes code on is whichever dev server started first, served
		# from the archive's own origin behind the archive's own session.
		echo "  warning: WEB_APP_URL is not set in $ENV_FILE" >&2
		echo "           photod falls back to http://127.0.0.1:3000, not to serving no gallery." >&2
		echo "           fix: add WEB_APP_URL=http://127.0.0.1:$_want" >&2
		;;
	*)
		echo "  warning: photoweb.service binds $_want, but WEB_APP_URL is $_have" >&2
		echo "           photod will proxy whatever is on that port, or 502 if nothing is." >&2
		echo "           fix: WEB_APP_URL=http://127.0.0.1:$_want in $ENV_FILE" >&2
		;;
	esac
}

# Reported apart from photod's health because the two failures are not the same
# size: photod is the archive, and a gallery that will not start is a browser
# with nothing to draw rather than a phone that cannot back up.
web_healthy() {
	if [ -n "$NO_WEB" ] || [ -n "$DRY" ]; then
		return 0
	fi
	_port=$(web_port "$1")
	if ! command -v curl >/dev/null 2>&1; then
		step "gallery restarted (curl not found, health not checked)"
		return 0
	fi
	i=0
	while [ "$i" -lt 30 ]; do
		if curl -sf --max-time 2 -o /dev/null "http://127.0.0.1:$_port/"; then
			step "gallery is up on 127.0.0.1:$_port"
			return 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	echo >&2
	echo "photobackup-admin: the gallery did not answer http://127.0.0.1:$_port/" >&2
	echo "  photod is up and serving the API; the gallery is what is down." >&2
	sudo journalctl -u photoweb --no-pager --lines=30 >&2 || true
	return 1
}

# web_port reads the number out of the unit rather than repeating it, so the
# port lives in exactly one place. photod finds the same process through
# WEB_APP_URL; the two disagreeing is the failure this avoids.
web_port() {
	_p=$(sed -n 's/^Environment=PORT=\([0-9][0-9]*\)$/\1/p' "$1/deploy/photoweb.service" | head -1)
    [ -n "$_p" ] || _p=8790
	printf '%s\n' "$_p"
}

# web_build runs before anything is stopped. next build with output:
# "standalone" traces the server's imports into .next/standalone, but leaves the
# client assets where they were — so .next/static has to be carried across by
# hand. A gallery deployed without it renders once and then loads no JavaScript
# and no CSS at all, which looks like a broken app rather than a broken deploy.
#
# Since the gallery started importing @photobackup/core, which lives above web/,
# tracing has to start at the repo root — and Next writes the app under its path
# relative to that root. So the tree it produces is two levels rather than one:
#
#   .next/standalone/web/server.js       the app, with its own node_modules
#   .next/standalone/node_modules/.pnpm  the hoisted store the app links into
#
# Both halves are needed and exactly one link crosses between them, so the tree
# is staged whole rather than flattened: flattening would mean rewriting that
# link, and a link left pointing two directories above the stage points at /opt
# on the archive machine. What absorbs the nesting instead is the last line —
# a relative symlink at the stage root, so /opt/photoweb/server.js still exists,
# web_install's guard still finds it, and photoweb.service's ExecStart is
# unchanged. node resolves it to its real path, so the app still runs with
# __dirname inside web/ where its .next is.
web_build() {
	if [ -n "$NO_WEB" ]; then
		return 0
	fi
	step "building the gallery"
	WEB_STAGE=$2/web
	if [ -n "$DRY" ]; then
		printf '  would: npm --prefix %s/web run build\n' "$1"
		# Staged so the rsync a dry run prints is the one it would run.
		mkdir -p "$WEB_STAGE" && : >"$WEB_STAGE/server.js"
		return 0
	fi
	( cd "$1/web" && npm run build ) || return 1

	[ -f "$1/web/.next/standalone/web/server.js" ] ||
		die "redeploy: no standalone server was produced — is output: \"standalone\" still set in web/next.config.ts?"

	mkdir -p "$WEB_STAGE/web/.next"
	cp -a "$1/web/.next/standalone/." "$WEB_STAGE/"
	cp -a "$1/web/.next/static" "$WEB_STAGE/web/.next/static"
	[ -d "$1/web/public" ] && cp -a "$1/web/public" "$WEB_STAGE/web/public"
	ln -sfn web/server.js "$WEB_STAGE/server.js"
	return 0
}

# web_install swaps the tree and restarts. Deliberately after photod is up: the
# gallery failing must not hold the API down with it, and photod answers 502
# through frontdoor.go while this is between versions rather than failing.
web_install() {
	if [ -n "$NO_WEB" ]; then
		return 0
	fi
	# Never a bare "$WEB_STAGE/" without this. An unset stage expands to "/",
	# which would make the line below an rsync --delete of the root filesystem
	# into $WEB_DEST. It cannot happen on the path web_build takes today; it is
	# one early return away from happening, and the blast radius is the whole
	# machine, so the invariant is asserted rather than reasoned about.
	[ -n "$WEB_STAGE" ] && [ -f "$WEB_STAGE/server.js" ] ||
		die "redeploy: the gallery was never staged — refusing to sync $WEB_DEST"

	step "installing the gallery"
	# --delete so a file that stopped being part of the build stops being
	# served; the cache is excluded because it is the one thing under there
	# the running process owns.
	run sudo rsync -a --delete --exclude '.next/cache' "$WEB_STAGE/" "$WEB_DEST/"
	run sudo chown -R photoweb:photoweb "$WEB_DEST"
	run sudo install -d -o photoweb -g photoweb -m 0755 "$WEB_DEST/.next/cache"

	step "restarting the gallery"
	run sudo systemctl restart photoweb
}

redeploy() {
	src=${PHOTOBACKUP_SRC:-}

	while [ $# -gt 0 ]; do
		case $1 in
		--src)
			[ $# -ge 2 ] || die "redeploy: --src needs a directory"
			src=$2
			shift 2
			;;
		--src=*)
			src=${1#--src=}
			shift
			;;
		--no-db)
			NO_DB=yes
			shift
			;;
		--no-web)
			NO_WEB=yes
			shift
			;;
		--dry-run)
			DRY=yes
			shift
			;;
		-h | --help)
			redeploy_usage
			return 0
			;;
		*)
			redeploy_usage
			die "redeploy: unknown argument $1"
			;;
		esac
	done

	if [ -n "$src" ]; then
		src=$(repo_root "$src") || die "redeploy: $src is not a photos-backup checkout"
	else
		src=$(repo_root .) || die "redeploy: run this from the repository, or pass --src DIR"
	fi

	command -v go >/dev/null 2>&1 || die "redeploy: go is not on PATH"
	[ -e "$UNIT_DIR/photod.service" ] ||
		die "redeploy: photod.service is not installed — see deploy/README.md"

	rev=$(git -C "$src" describe --always --dirty --tags 2>/dev/null || echo unknown)
	step "redeploying from $src ($rev)"

	# Ask for the password now. The alternative is a sudo prompt appearing
	# between the stop and the start, with the service down while it waits.
	[ -n "$DRY" ] || sudo -v

	db_detect "$src"
	web_detect "$src"
	web_check_url "$src"

	stage=$(mktemp -d) || die "redeploy: cannot create a build directory"
	trap 'rm -rf "$stage"' EXIT INT TERM

	# Before the stop, deliberately: a failed build must cost nothing but time.
	step "building"
	go build -C "$src/server" -o "$stage/photod" ./cmd/photod
	go build -C "$src/server" -o "$stage/photobackup" ./cmd/photobackup

	# Same contract as the Go build above: before the stop, so a gallery that
	# does not compile costs nothing but the time it took to find out.
	web_build "$src" "$stage" || die "redeploy: the gallery did not build — nothing was changed"

	step "syncing units"
	sync_unit "$src/deploy/photod.service" "$UNIT_DIR/photod.service"
	sync_unit "$src/deploy/photobackup-verify.service" "$UNIT_DIR/photobackup-verify.service"
	sync_unit "$src/deploy/photobackup-verify.timer" "$UNIT_DIR/photobackup-verify.timer"
	# Skipped on a machine that never installed it, which is most of them:
	# photo-ml is optional and this is the unit file, not the service. Its
	# Python and its venv are updated separately — see deploy/README.md
	# § photo-ml — because rebuilding a 4GB venv is not something a two-second
	# photod redeploy should do on every run.
	sync_unit "$src/deploy/photo-ml.service" "$UNIT_DIR/photo-ml.service"
	sync_unit "$src/deploy/photoweb.service" "$UNIT_DIR/photoweb.service"
	sync_unit "$src/deploy/photobackup.avahi.service" "$AVAHI_SERVICE"

	step "stopping photod"
	run sudo systemctl stop photod

	step "installing binaries"
	install_atomic "$stage/photod" "$BIN_DIR/photod" 0755
	install_atomic "$stage/photobackup" "$BIN_DIR/photobackup" 0755
	# This script, replacing itself, from the same tree as the binaries.
	if ! cmp -s "$src/deploy/photobackup-admin" "$BIN_DIR/photobackup-admin"; then
		echo "  update  $BIN_DIR/photobackup-admin"
		install_atomic "$src/deploy/photobackup-admin" "$BIN_DIR/photobackup-admin" 0755
	fi

	if [ -n "$UNITS_CHANGED" ]; then
		run sudo systemctl daemon-reload
	fi

	db_cycle || return 1

	# With photod down and the new binary in place: the migrations that ship
	# with this build are applied by the build that needs them, and a schema
	# change that fails is a failed deploy here rather than a daemon that will
	# not start. photod migrates on its own start too, so this is belt and
	# braces — but the braces are the ones that report.
	step "applying migrations"
	if [ -n "$DRY" ]; then
		printf '  would: photobackup migrate\n'
	elif ! as_photod migrate; then
		echo >&2
		echo "photobackup-admin: migrations failed — photod left stopped" >&2
		if [ -z "$COMPOSE" ]; then
			echo "  the database was not touched by this run (--no-db, or no compose file):" >&2
			echo "  check that postgres is up and reachable at DATABASE_URL." >&2
		fi
		echo "  the new binaries are installed; fix the schema and run:" >&2
		echo "    photobackup-admin migrate && sudo systemctl start photod" >&2
		return 1
	fi

	step "starting photod"
	run sudo systemctl start photod

	if [ -n "$DRY" ]; then
		web_install
		step "dry run: nothing changed"
		return 0
	fi

	addr=$(health_addr)
	if command -v curl >/dev/null 2>&1; then
		if ! wait_healthy "$addr"; then
			echo >&2
			echo "photobackup-admin: photod did not answer https://$addr/health" >&2
			sudo systemctl --no-pager --lines=0 status photod >&2 || true
			sudo journalctl -u photod --no-pager --lines=30 >&2 || true
			return 1
		fi
		step "photod is up on $addr ($rev)"
	else
		sudo systemctl is-active --quiet photod ||
			die "redeploy: photod is not running — journalctl -u photod -n 30"
		step "photod is running ($rev; curl not found, health not checked)"
	fi

	# The gallery last, once the API it calls is already answering.
	web_install || return 1
	web_healthy "$src" || return 1
	return 0
}

# ---------------------------------------------------------------- dispatch ---

if [ "${1:-}" = "redeploy" ]; then
	shift
	redeploy "$@"
	exit
fi

if [ ! -r "$ENV_FILE" ] && [ "$(id -u)" -ne 0 ]; then
	# Readable only by root:photod, so this check is advisory when unprivileged.
	sudo test -r "$ENV_FILE" || {
		echo "photobackup-admin: cannot read $ENV_FILE — is photod installed?" >&2
		exit 1
	}
fi

as_photod "$@"
