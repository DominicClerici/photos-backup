# A peer dependency is the consumer's to provide, and here that matters more
# than usual: packages/core lists react as a peer, and an auto-installed copy
# under packages/core/node_modules is the one Metro would resolve from the
# hooks — giving the phone react 19.2.8 while the app itself runs 19.2.3, which
# is two Reacts and an "invalid hook call" on the first render.
#
# Both apps declare react themselves, so there is nothing to install on their
# behalf. This is what keeps core's half of the split honest at runtime rather
# than only in package.json.
auto-install-peers=false
